generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model College {
  id          Int      @id @default(autoincrement())
  name        String
  location    String
  state       String
  type        String   // Private / Public / Deemed
  category    String   // Engineering / Medical / Management / Arts
  fees        Int      // annual fees in INR
  rating      Float
  totalRating Int      @default(0)
  reviewCount Int      @default(0)
  established Int
  description String
  website     String?
  image       String?

  // Placement stats
  avgPackage  Float    // in LPA
  maxPackage  Float    // in LPA
  placementRate Float  // percentage

  // Courses (stored as JSON string)
  courses     String   // JSON array

  // Top recruiters
  recruiters  String   // JSON array

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
